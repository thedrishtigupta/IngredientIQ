# Copy to .env (cp .env.example .env). .env is gitignored - never commit it.

# Local Postgres (docker-compose.yml reads these too)
PGHOST=localhost
PGPORT=5432
PGDATABASE=ingredientiq
PGUSER=postgres
PGPASSWORD=ingredientiq

# LLM explanations via OpenRouter (https://openrouter.ai/keys).
# Leave the key blank to run without an LLM: the API falls back to template explanations.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
